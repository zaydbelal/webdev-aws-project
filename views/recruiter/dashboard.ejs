<%- include('../partials/header', { title: 'Dashboard' }) %>
<h1>Recruiter Dashboard</h1>

<% if (!company) { %>
  <div class="card">
    <p>You haven't created a company profile yet.</p>
    <a class="button" href="/recruiter/company">Create Company Profile</a>
  </div>
<% } else { %>
  <div class="card">
    <h2><%= company.name %> <span class="badge badge-<%= company.status %>"><%= company.status %></span></h2>
    <% if (company.status === 'pending') { %>
      <p class="muted small">Your company is awaiting Placement Cell approval. Job postings won't be visible to students until it's approved.</p>
    <% } else if (company.status === 'rejected') { %>
      <p class="muted small">Your company profile was rejected by the Placement Cell. Update your details and contact the admin.</p>
    <% } %>
  </div>

  <div class="stats-row">
    <div class="stat"><div class="value"><%= jobCount %></div><div class="label">Job Postings</div></div>
    <div class="stat"><div class="value"><%= applicationCount %></div><div class="label">Total Applicants</div></div>
  </div>

  <div class="card">
    <h2>Recent Applications</h2>
    <% if (recentApplications.length === 0) { %>
      <p class="muted">No applications yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Student</th><th>Job</th><th>Status</th><th>Applied</th></tr></thead>
          <tbody>
            <% recentApplications.forEach(function(a) { %>
              <tr>
                <td><%= a.student_name %></td>
                <td><a href="/recruiter/jobs/<%= a.job_id %>"><%= a.job_title %></a></td>
                <td><span class="badge badge-<%= a.status %>"><%= a.status.replace('_', ' ') %></span></td>
                <td><%= new Date(a.applied_at).toLocaleDateString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <a class="button" href="/recruiter/jobs/new">+ Post a New Job</a>
<% } %>
<%- include('../partials/footer') %>
